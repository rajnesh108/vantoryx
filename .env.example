# PostgreSQL — matches docker-compose.yml
DATABASE_URL=postgresql://rag:rag@localhost:5432/vantoryx

# API
PORT=4000

# Leave unset to store files in <repo>/uploads.
# Set an absolute path if you override it. The API and embedding service must see the same folder.
# UPLOAD_DIR=

# Local embedding service
EMBEDDING_SERVICE_URL=http://127.0.0.1:8000
EMBEDDING_TIMEOUT_MS=180000
# Schema is vector(768), which matches all-mpnet-base-v2.
EMBEDDING_DIM=768
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2

# Chunking and retrieval
CHUNK_SIZE=1000
CHUNK_OVERLAP=180
TOP_K=5
BM25_TOP_K=20
VECTOR_TOP_K=20
RERANK_TOP_K=5
RERANKER_ENABLED=true
# LangGraph agent: plan queries, route categories, then retry when passages are not enough.
AGENT_ENABLED=true
AGENT_MAX_RETRIES=1
AGENT_MAX_QUERIES=3
# MCP tools. Leave MCP_SERVERS unset to use the bundled calculator server.
# Set MCP_ENABLED=false to keep the V3 search path with no tool calls.
MCP_ENABLED=true
MCP_MAX_CALLS=1
MCP_TIMEOUT_MS=20000
# MCP_SERVERS=[{"name":"calculators","transport":"stdio","command":"node","args":["--import","tsx","src/mcp/calculators.ts"]}]
# HTTP example: {"name":"guidelines","transport":"http","url":"http://127.0.0.1:3000/mcp"}
# Cross-encoder loaded by the embedding server.
RERANKER_MODEL=BAAI/bge-reranker-base

# Chat provider. One setting selects the implementation.
# Local:  ollama or llamacpp. llama.cpp can also set LLM_GGUF to the file llama-server loaded.
# Cloud:  openai, enabled in the model menu with OPENAI_API_KEY.
# Leave LLM_BASE_URL unset to use that provider's default address.
# ollama    http://127.0.0.1:11434/v1
# llamacpp  http://127.0.0.1:8081/v1
# openai    https://api.openai.com/v1
LLM_PROVIDER=ollama
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_GGUF=C:\models\guide.gguf
LLM_API_KEY=ollama
# Enables OpenAI in the search-page model list. Leave empty to keep that choice unavailable.
# OPENAI_API_KEY=
LLM_MODEL=llama3.1
LLM_TIMEOUT_MS=120000
# USD per 1,000,000 tokens. Leave at 0 for a local model such as Ollama.
LLM_PROMPT_USD_PER_MILLION=0
LLM_COMPLETION_USD_PER_MILLION=0
# Keep the latest chat traces in memory. They clear when the API process stops.
OBSERVATION_ENABLED=true
OBSERVATION_LIMIT=200

# First admin account. The API stores a hash in the users table and refreshes it from these values on startup.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
