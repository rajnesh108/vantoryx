# PostgreSQL — matches docker-compose.yml
DATABASE_URL=postgresql://rag:rag@localhost:5432/vantoryx

# API
PORT=4000

# Leave unset to store files in <repo>/uploads.
# Set an absolute path if you override it. The API and embedding service must see the same folder.
# UPLOAD_DIR=

# Local embedding service
EMBEDDING_SERVICE_URL=http://127.0.0.1:8000
EMBEDDING_TIMEOUT_MS=180000
# Schema is vector(768), which matches all-mpnet-base-v2.
EMBEDDING_DIM=768
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2

# Chunking and retrieval
CHUNK_SIZE=1000
CHUNK_OVERLAP=180
TOP_K=5
BM25_TOP_K=20
VECTOR_TOP_K=20
RERANK_TOP_K=5
RERANKER_ENABLED=true
# LangGraph agent: plan queries, route categories, then retry when passages are not enough.
AGENT_ENABLED=true
AGENT_MAX_RETRIES=1
AGENT_MAX_QUERIES=3
# Cross-encoder loaded by the embedding server.
RERANKER_MODEL=BAAI/bge-reranker-base

# Any OpenAI-compatible chat API.
# Ollama:  LLM_BASE_URL=http://127.0.0.1:11434/v1  LLM_API_KEY=ollama  LLM_MODEL=llama3.1
# OpenAI:  LLM_BASE_URL=https://api.openai.com/v1  LLM_API_KEY=sk-...   LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.1
LLM_TIMEOUT_MS=120000

# First admin account. The API stores a hash in the users table and refreshes it from these values on startup.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
